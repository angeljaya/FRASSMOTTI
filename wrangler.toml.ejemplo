# EJEMPLO (no activo). Solo si quieres configurar el KV por archivo en vez de por el panel de Cloudflare:
#  1) renómbralo a wrangler.toml  2) pega el id real del KV  3) despliega con: npx wrangler pages deploy . --project-name frassmotti
#  OJO: con este archivo activo, un comando "npx wrangler deploy" (Workers) FALLA con "Missing entry-point". Usa siempre "wrangler pages deploy".
# Cloudflare Pages + KV para los links cortos (tarjeta.html?id=XXXXXXXX)
name = "frassmotti"
pages_build_output_dir = "."
compatibility_date = "2024-11-01"

[[kv_namespaces]]
binding = "CARDS"                          # el nombre que usa functions/api/card.js (env.CARDS)
id = "PEGA_AQUI_EL_ID_DEL_NAMESPACE"       # npx wrangler kv namespace create CARDS  -> te devuelve este id
